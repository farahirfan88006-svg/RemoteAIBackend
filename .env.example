# ─────────────────────────────────────────────────────────────
# RemoteAI Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Variables marked REQUIRED will cause the server to refuse to
# start (fail-fast) if left unset — see src/config/env.js.
# ─────────────────────────────────────────────────────────────

# --- Core (REQUIRED) ---------------------------------------------------

# Node environment: "development" or "production"
NODE_ENV=development

# MongoDB Atlas connection string (Free M0 tier is sufficient)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/remoteai

# Comma-separated list of frontend origin(s) allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Secret used to sign/verify JWTs (auth). Use a long, random value —
# e.g. `openssl rand -hex 32`. Rotating this invalidates every existing
# session.
JWT_SECRET=

# --- Server ---------------------------------------------------------------

# Port the Express server listens on (Render sets this automatically in
# production — safe to leave unset there)
PORT=5000

# --- Sync scheduling (used starting Phase 2 — safe defaults already apply) --

# How often the job-sync scheduler runs, in hours
SYNC_INTERVAL_HOURS=6

# If "true", runs one sync immediately on server boot (useful for first deploy)
SYNC_ON_BOOT=false

# --- Rate limiting -------------------------------------------------------

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# Stricter limiter applied only to /api/ai/* (AI calls are far more
# expensive than a typical read endpoint). Optional — falls back to sane
# defaults if unset.
AI_RATE_LIMIT_WINDOW_MINUTES=15
AI_RATE_LIMIT_MAX_REQUESTS=30

# --- Auth (optional — sensible defaults already apply) --------------------

# How long an issued JWT stays valid, e.g. "7d", "12h", "30m"
JWT_EXPIRES_IN=7d

# bcrypt cost factor — higher is slower but more resistant to brute force
BCRYPT_SALT_ROUNDS=12

# --- Resume Analyzer (optional) -------------------------------------------

# Max accepted resume upload size, in bytes (default 5MB)
RESUME_UPLOAD_MAX_BYTES=5242880

# --- Source-specific credentials (used starting Phase 2) -----------------

# USAJobs requires a registered API key and an identifying User-Agent
# https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Wellfound and YC's "Work at a Startup" don't publish a free public jobs
# API. Leave these unset to skip both sources gracefully, or point them
# at a licensed/partner feed you have access to.
WELLFOUND_FEED_URL=
WELLFOUND_API_KEY=
YCJOBS_FEED_URL=
YCJOBS_API_KEY=

# --- AI features (Resume Analyzer, Resume Rewrite, Career Coach, Cover ---
# --- Letter AI, Mock Interview, Job Match Score) --------------------------

# Which provider lib/ai/utils/providerResolver.js resolves for every AI
# call. Leave unset (or set to "free") to use the zero-cost, no-external-
# call placeholder provider — safe default, no API key needed.
# Valid values: free | openai | gemini | openrouter | groq
# If set to openai/gemini/openrouter/groq without the matching key below, or
# to an unrecognized value, requests automatically fall back to "free" (never
# a hard failure) — see lib/config/aiEnv.js for the startup warning this
# produces.
AI_PROVIDER=free

# Required only if AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required only if AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Required only if AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional, sent as attribution headers to OpenRouter
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=

# Required only if AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Max time (ms) any real provider (openai/gemini/openrouter/groq) will wait
# for a response before aborting the request and surfacing a timeout error
# (so aiService.js can fall back to the free provider instead of hanging).
AI_PROVIDER_TIMEOUT_MS=20000

# Free-tier AI usage limits (see lib/ai/config/limits.js) are enforced by
# default. Set to "true" to temporarily disable enforcement for every user
# (e.g. while billing/payments aren't live yet) without a code change —
# usage is still tracked either way. Leave unset/false in production once
# limits should be enforced.
AI_TEMP_FREE_ACCESS=false

# --- AI response caching & background jobs (optional) ---------------------

# Shared by lib/cache/redis.js (AI response cache) and lib/jobs/queue.js
# (background AI job queue). Leave unset to disable both gracefully — the
# app keeps working synchronously and uncached with no errors.
REDIS_URL=

# How long a cached AI response stays valid, in seconds (default 1 hour).
AI_CACHE_TTL_SECONDS=3600

# Concurrency for `npm run worker:ai` (lib/jobs/workers/ai.worker.js), a
# separate process — not started automatically by `npm start`.
AI_WORKER_CONCURRENCY=2

# --- Logging (optional) ----------------------------------------------------

# error | warn | info | debug — see lib/monitoring/logger.js
LOG_LEVEL=info

