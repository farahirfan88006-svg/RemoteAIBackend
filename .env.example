# ─────────────────────────────────────────────────────────────
# RemoteAI Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Variables marked REQUIRED will cause the server to refuse to
# start (fail-fast) if left unset — see src/config/env.js.
# ─────────────────────────────────────────────────────────────

# --- Core (REQUIRED) ---------------------------------------------------

# Node environment: "development" or "production"
NODE_ENV=development

# MongoDB Atlas connection string (Free M0 tier is sufficient)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/remoteai

# Comma-separated list of frontend origin(s) allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Secret used to sign/verify JWTs (auth). Use a long, random value —
# e.g. `openssl rand -hex 32`. Rotating this invalidates every existing
# session.
JWT_SECRET=

# --- Server ---------------------------------------------------------------

# Port the Express server listens on (Render sets this automatically in
# production — safe to leave unset there)
PORT=5000

# --- Sync scheduling (used starting Phase 2 — safe defaults already apply) --

# How often the job-sync scheduler runs, in hours
SYNC_INTERVAL_HOURS=6

# If "true", runs one sync immediately on server boot (useful for first deploy)
SYNC_ON_BOOT=false

# --- Rate limiting -------------------------------------------------------

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# --- Auth (optional — sensible defaults already apply) --------------------

# How long an issued JWT stays valid, e.g. "7d", "12h", "30m"
JWT_EXPIRES_IN=7d

# bcrypt cost factor — higher is slower but more resistant to brute force
BCRYPT_SALT_ROUNDS=12

# --- Resume Analyzer (optional) -------------------------------------------

# Max accepted resume upload size, in bytes (default 5MB)
RESUME_UPLOAD_MAX_BYTES=5242880

# --- Source-specific credentials (used starting Phase 2) -----------------

# USAJobs requires a registered API key and an identifying User-Agent
# https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Wellfound and YC's "Work at a Startup" don't publish a free public jobs
# API. Leave these unset to skip both sources gracefully, or point them
# at a licensed/partner feed you have access to.
WELLFOUND_FEED_URL=
WELLFOUND_API_KEY=
YCJOBS_FEED_URL=
YCJOBS_API_KEY=
